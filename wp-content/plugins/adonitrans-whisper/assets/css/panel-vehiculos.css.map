@use "global/variables" as *;

#wrap-vehiculos {
    display: flex;
    flex-wrap: wrap;
    row-gap: 20px;

    .wrap-listado-vehiculos,
    .wrap-gestion-vehiculos {
        width: 100%;
    }

    form {
        display: flex;
        flex-wrap: wrap;
        column-gap: 20px;
        row-gap: 25px;

        .adonitrans-tabs-content {
            .tab-content {
                &.active {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 25px;
                }

            }

        }

        fieldset {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .wrap {
            width: 100%;
            position: relative;

            label {
                text-shadow: none;
                margin-bottom: 5px;
            }

            a {
                color: $primary-color;
                text-decoration: underline;
                transition: all .5s;

                &:hover {
                    color: $color4;
                }

            }

            select,
            input:not([type="radio"]):not([type="checkbox"]) {
                width: 100%;
            }

            .select2-container {
                .select2-selection--single {
                    height: 42px;

                    .select2-selection__rendered {
                        line-height: 42px;
                    }

                }

            }

            &.wrap-2 {
                width: calc(50% - 25px);
            }

        }

        #wrap-archivos-vehiculo, #wrap-imagenes-vehiculo {
            margin-bottom: 20px;
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .archivo-vehiculo, .imagen-vehiculo {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            justify-content: space-between;
            width: 100%;

            .wrap-file {
                > i {
                    position: absolute;
                    right: 0;
                    top: 0;
                    color: red;
                    cursor: pointer;
                    transition: all 0.5s;
                    z-index: 9;

                    &:hover {
                        transform: scale(1.1);
                    }

                }

            }

            input {
                height: 48px;
            }

        }

    }

    /*REPONSIVE*/
    // Ajustes para tablet
    @media (max-width:$laptop) {
        form {
            .wrap {
                &.wrap-2 {
                    width: 48%;
                }

            }

        }

    }

    @media (max-width:$mobile) {
        form {
            .wrap {
                &.wrap-2 {
                    width: 100%;
                }

            }

        }

    }

}
