@use "global/variables" as *;

#wrap-vehiculos {
    display: flex;
    flex-wrap: wrap;
    row-gap: 20px;

    .wrap-listado-vehiculos,
    .wrap-gestion-vehiculos {
        width: 100%;
    }

    form {
        display: flex;
        flex-wrap: wrap;
        column-gap: 20px;
        row-gap: 25px;

        .wrap {
            width: 100%;
            position: relative;

            label {
                text-shadow: none;
                margin-bottom: 5px;
            }

            a {
                color: $primary-color;
                text-decoration: underline;
                transition: all .5s;

                &:hover {
                    color: $color4;
                }

            }

            .select2-container {
                .select2-selection--single {
                    height: 42px;

                    .select2-selection__rendered {
                        line-height: 42px;
                    }

                }

            }

            &.wrap-2 {
                width: 49%;
            }

        }

    }

    /*REPONSIVE*/
    // Ajustes para tablet
    @media (max-width:$laptop) {
        form {
            .wrap {
                &.wrap-2 {
                    width: 48%;
                }

            }

        }

    }

    @media (max-width:$mobile) {
    }

}
