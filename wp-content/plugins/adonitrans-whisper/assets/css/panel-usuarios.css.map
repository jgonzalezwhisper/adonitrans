@use "global/variables" as *;

#wrap-usuarios {
  display: flex;
  flex-wrap: wrap;
  row-gap: 20px;

  .wrap-gestion-usuarios,
  .wrap-listado-usuarios {
    width: 100%;
  }

  .wrap-gestion-usuarios {
    display: none;
  }

}

.adonitrans-plug {
  #table-usuarios_wrapper,
  #table-vehiculos_wrapper,
  #table-empresas_wrapper {
    #table-usuarios_length label,
    #table-usuarios_filter label,
    #table-usuarios_info,
    #table-usuarios_paginate,
    #table-vehiculos_length label,
    #table-vehiculos_filter label,
    #table-vehiculos_info,
    #table-vehiculos_paginate,
    #table-empresas_length label,
    #table-empresas_filter label,
    #table-empresas_info,
    #table-empresas_paginate {
      font-size: 16px;
      font-weight: 400;
      color: #6c6868;
    }

    #table-usuarios_filter,
    #table-vehiculos_filter,
    #table-empresas_filter {
      margin-bottom: 25px;
    }

    #table-usuarios_info,
    #table-usuarios_paginate,
    #table-vehiculos_info,
    #table-vehiculos_paginate,
    #table-empresas_paginate {
      margin-top: 25px;
    }

    #table-usuarios_paginate a.paginate_button.current,
    #table-vehiculos_paginate a.paginate_button.current,
    #table-empresas_paginate a.paginate_button.current {
      background: #086acf;
      color: #fff !important;
      font-weight: 700;
      border: 1px solid #626262;
      padding: 2px 15px;
      border-radius: 7px;
      cursor: pointer;
    }

  }

  table.table-adoni {
    paddding: 35px 0 !important;

    thead {
      tr {
        th,
        th.sorting_asc {
          background-color: #535353;
          color: #fff;
          transition: 0.5s;
          font-size: 17px;
          border-right: 1px solid rgba(255, 255, 255, 0.4);
        }

      }

    }

    tbody {
      tr {
        background-color: #fff;
        font-size: 16px;
        font-weight: 400;

        &.odd > * {
          box-shadow: none !important;
        }

        &.odd > .sorting_1 {
          background-color: #fff;
          box-shadow: none !important;
        }

        td:nth-child(2) {
          font-weight: 600;
        }

      }

    }

  }

}

/***DRIVERS PANEL****/
.wrap-gestion-conductor {
  #conductor-form {
    margin-top: 60px;

    #wrap-contador-espera {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 35px;
      width: 100%;
      font-size: 26px;
      font-weight: 600;
      font-family: 'POPPINS';
    }

    .trayecto_info {
      width: 100%;
      display: flex;

      .trayecto_user {
        line-height: 1.3;
        gap: 5px;
        display: flex;
        flex-direction: column;

        p {
          margin: 0;
        }

      }

      .column {
        width: 33%;
        display: flex;
        flex: 1;
        align-items: center;
        border-right: 1px solid rgba(0, 0, 0, .1);

        &:nth-child(1) {
          .profile_photo {
            text-align: center;

            img {
              width: 150px;
              height: 150px;
              border-radius: 50%;
            }

          }

        }

        &:nth-child(2) {
          background-color: #fbfbfb;
        }

        &:nth-child(2),
        &:nth-child(3) {
          padding-left: 20px;
        }

      }

    }

    .profile_info_user {
      .wrap {
        label {
          font-size: 16px;
          font-weight: 800;
          text-decoration: underline;
          color: #086acf;
          margin: 0;
        }

        h4 {
          margin: 5px 0 15px;
          font-weight: 600;
          font-size: 20px;
        }

      }

    }

    .trayecto_user {
      label {
        font-weight: 700;
        letter-spacing: 0;
        color: #0054ae;
        font-size: 19px;

        i {
          position: relative;
          top: 5px;
          right: 0;
          font-size: 15px;
          padding-right: 15px;
        }

      }

      input {
        width: 100%;
        border: none;
        box-shadow: none;
        padding: 5px 20px;

        &.time_user {
          color: #777;
          font-weight: 600;
          font-size: 15px;
        }

      }

      &:last-child {
        margin-top: 25px;
      }

    }

    .trayecto_acciones {
      .trayecto_bottons {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin: 0;

        .button {
          margin: 0;
        }

        p {
          font-size: 21px;
          padding: 0;
          margin: 0;
          font-weight: 700;
        }

        button {
          background: #086acf;
          padding: 10px 20px;
          border: 2px solid #000;
          color: #000;
          font-weight: 700;
          text-transform: uppercase;
          font-size: 15px;
          border-radius: 10px;

          &:hover {
            background: #777 !important;
            color: #fff !important;
          }

        }

        &.bmedio {
          padding-top: 25px;
          flex-direction: column;

          h5 {
            margin: 0;
          }

          ul {
            list-style: none;
            padding: 0;

            li {
              position: relative;
              padding-left: 26px;

              &:before {
                content: "\eed9";
                font-family: Icofont;
                position: absolute;
                top: 0;
                left: 0;
                color: green;
              }

            }

          }

        }

      }

      .trayecto_bottons.binicio {
        button {
          background: #ffe407;
          color: #000;
        }

      }

      .trayecto_bottons.bmedio {
        button {
          background: #55a9ff;
          color: #fff;
        }

      }

      .trayecto_bottons.bfinal {
        button {
          background: #3e41fb;
          color: #fff;
        }

      }

    }

    .trayecto_finalizar {
      width: 90%;
      background: #e3e3e3;
      border-radius: 20px;
      padding: 20px 40px;
      margin: 0 auto;

      .titulo {
        text-align: center;
        text-transform: uppercase;
        font-size: 22px;
        color: #000;
        font-weight: 700;
        margin-bottom: 50px;
      }

      .trayecto_peajes {
        display: flex;
        gap: 20px;
        justify-content: initial;
        align-content: center;
        align-items: center;

        h4 {
          font-weight: 600;
          font-size: 17px;
        }

        .peaje_option {
          display: flex;
          width: fit-content;
          background: #39bd1e;
          padding: 5px 15px;
          border-radius: 5px;
          color: #fff;
        }

        .peaje_option_no {
          background: #a63d14 !important;
        }

        .peaje_si_aplica {
          display: inline-grid;

          input {
            font-size: 15px;
            padding: 10px 20px;
            color: #000;
            border-radius: 10px;
            border: 2px solid #39bd1e;
            background: #fff;
            margin-bottom: 15px;
          }

          label {
            font-size: 15px;
            margin-top: 15px;
            font-weight: 600;
            letter-spacing: 0;
          }

        }

      }

      .trayecto_comments {
        label {
          font-weight: 600;
          font-size: 17px;
        }

      }

      .trayecto_total {
        padding: 20px 0;

        h4 {
          font-size: 25px;
          text-transform: uppercase;
          font-weight: 700;
          display: flex;
          align-items: center;
          justify-content: space-between;
          background-color: #f1f1f1;
          gap: 20px;
          padding: 15px;

          span {
            background: #086ACF;
            color: #fff;
            padding: 10px 20px;
            border-radius: 5px;
            margin-left: 15px;
            font-weight: 500;
          }

        }

        ul {
          list-style: none;
          padding: 0;

          li {
            position: relative;
            padding-left: 26px;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;

            &:before {
              content: "\eed9";
              font-family: Icofont;
              position: absolute;
              top: 0;
              left: 0;
              color: green;
            }

          }

        }

        p {
          color: #3c3b3b;
          display: flex;

          span {
            color: #000;
            font-weight: 600;
            font-size: 18px;
            margin-left: 25px;
          }

        }

      }

    }

    .ocultar{
      display: none;
    }

  }

}
