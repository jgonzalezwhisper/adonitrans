@use "global/base";
@use "global/dataTable";
@use "global/variables" as *;

body.adonitrans-plug {
  overflow: hidden;
}

#panel-administracion {
  background-color: #086ACF;
  display: flex;
  flex-wrap: wrap;
  height: 100vh;
  padding: 20px 40px;

  #franja {
    width: 100%;
    display: flex;

    .contimg {
      width: 15%;
      padding: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.5);
      display: flex;

      img {
        transition: 0.5s;
        max-height: 70px;
        padding-left: 15px;

        &:hover {
          transform: scale(1.1);
        }

      }

    }

    .continfo {
      width: 83%;
      color: #000;
      font-size: 18px;
      text-shadow: none;
      font-weight: 700;
      background-color: #fff;
      border-radius: 30px 30px 0 0;
      padding: 20px;
      display: flex;
      align-content: center;
      justify-content: space-between;
      align-items: center;

      .continfo-right {
        display: flex;
        align-content: center;
        justify-content: end;
      }

      .continfo_user {
        text-align: right;
        font-size: 15px;
        color: #000;
        text-shadow: none;
        display: flex;
        align-items: center;
        position: relative;
        z-index: 99;

        .img_user {
          width: 40px;
          height: 40px;
          border-radius: 50px;
          margin-left: 10px;
          transition: 0.3s;

          &:hover {
            scale: 1.2;
          }

        }

        .dropdown {
          position: absolute;
          list-style: none;
          top: 45px;
          right: 0;
          background-color: $primary-color;
          display: flex;
          flex-wrap: wrap;
          flex-direction: column;
          row-gap: 5px;
          border-radius: 6px;
          padding: 0;
          overflow: hidden;
          transform: scale(0);
          opacity: 0;
          transition: 0.5s;

          li {
            display: inline-block;

            a {
              padding: 6px 16px 6px 27px;
              color: #fff;
              display: inline-block;
              width: 100%;
              font-weight: 500;

              &:hover {
                background-color: $color3;
              }

            }

          }

        }

        &:hover {
          .dropdown {
            transform: scale(1);
            opacity: 1;
          }

        }

      }

      .continfo_noti {
        margin-right: 20px;
        position: relative;

        &::before {
          content: "";
          width: 8px;
          height: 8px;
          position: absolute;
          right: 13.5%;
          border-radius: 9999px;
          background-color: rgba(211, 41, 41, 1);
        }

        i {
          color: #086ACF;
        }

      }

      label {
        text-shadow: none;
        margin-bottom: 5px;
      }

      a {
        color: $primary-color;
        text-decoration: underline;
        transition: all .5s;

        &:hover {
          color: $secondary-color;
        }

      }

      .select2-container {
        .select2-selection--single {
          height: 42px;

          .select2-selection__rendered {
            line-height: 42px;
          }

        }

      }

      &.wrap-2 {
        width: 49%;

        &.time {
          display: flex;
          align-items: center;
          justify-content: space-around;

          label {
            column-gap: 10px;
          }

        }

      }

      a {
        color: #086ACF;
        text-decoration: none;
      }

      span {
        padding: 0 5px;
        color: #086ACF;
      }

    }

  }

}

#lateral {
  background-color: #086ACF;
  color: #fff;
  width: 15%;
  padding: 0;
  height: calc(100vh - 120px);

  ul {
    list-style: none;
    padding: 0;

    li {
      padding: 15px 20px;
      font-size: 17px;
      letter-spacing: 1px;
      text-transform: capitalize;
      font-weight: 500;
      cursor: pointer;
      background-color: transparent;
      color: #fff;
      border-radius: 50px 0 0 50px;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      column-gap: 10px;
      animation: intro-menu-animation 0.4s ease-in-out 0.33333s forwards;
      animation-delay: 0.1s;

      i {
        font-size: 20px;
      }

      a {
        color: #fff;
      }

      &:hover {
        background-color: rgba(39, 74, 183, 0.4);
        transition-duration: 0.5s;

        a {
          color: #2d2d2d;
        }

      }

      &.active {
        background-color: #fff;
        color: #000;
      }

    }

  }

}

#informacion {
  width: 85%;
  height: calc(100vh - 120px);
  padding: 0;
  background-color: #fff;
  overflow: auto;
}

.wrap-gestion-usuarios {
  width: 100%;
}

form {
  display: flex;
  flex-wrap: wrap;
  column-gap: 20px;
  row-gap: 25px;

  &#ajustes-generales {
    flex-direction: column;
  }

  .wrap {
    width: 100%;
    position: relative;

    label {
      text-shadow: none;
      margin-bottom: 5px;
    }

    a {
      color: #086ACF;
      text-decoration: underline;
      transition: 0.5s;

      &:hover {
        color: #00b9d9;
      }

    }

    .select2-container {
      .select2-selection--single {
        height: 42px;

        .select2-selection__rendered {
          line-height: 42px;
        }

      }

    }

  }

  #payment-fields-container {
    h4 {
      background: $blue-dark;
      color: #fff;
      padding: 12px 20px;
      border-radius: 10px;
      width: 100%;
      text-align: center;
      font-weight: 700;
      font-size: 20px;
    }

  }

  #extra-fields-container,
  #payment-fields-container,
  .payment-row {
    display: flex;
    flex-wrap: wrap;
    column-gap: 20px;
    row-gap: 25px;

    &:not(:last-child) {
      margin-bottom: 40px;
    }

    .remove-payment-row {
      position: absolute;
      color: red;
      top: -6px;
      right: 0;
      background-color: #fff;
      border-radius: 50%;
      line-height: 1;
      font-size: 9px;
      padding: 8px;
      border: 1px solid;
      text-decoration: none;
      transition: 0.5s;

      &:hover {
        background-color: red;
        color: #fff;
        border-color: red;
      }

    }

  }

}

.wrap-title {
  background-color: #086acf;
  border-radius: 15px;

  .title {
    margin: 0 0 20px;
    line-height: 1;
    color: #fff;
    padding: 15px 20px;
    text-transform: uppercase;
    font-size: 22px;
    font-weight: 700;
    text-shadow: 0 0 4px rgba(0, 0, 0, .45)
  }

  &.activo,
  &.activa {
    background-color: #30bf30;
  }

  &.inactivo,
  &.inactiva {
    background-color: red;
  }

  &.pendiente {
    background-color: #ff8100;
  }

  &.por-asignar {
    background-color: red;
  }

  &.en-curso {
    background-color: #007bff;
  }

  &.finalizado {
    background-color: #28a745;
  }

  &.cancelado {
    background-color: #6c757d;
  }

}

.dropdown-menu-user {
  width: 224px;
  background-color: #086ACF;
  padding: 20px;
  border-radius: 10px;
  margin: 50px;
  display: none;
  position: absolute;
  top: 100px;
  right: 10px;
  z-index: 1000;
  opacity: 0;
  transition: top 0.6s ease, opacity 0.6s ease;

  &.active {
    display: block;
    top: 80px;
    opacity: 1;
  }

  .names {
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);

    h3 {
      color: #fff;
      font-size: 17px;
      font-weight: 700;
      margin: 0;

      span {
        display: block;
        font-weight: 400;
        font-size: 14px;
        padding-bottom: 15px;
      }

    }

  }

  .options {
    ul {
      list-style: none;
      padding: 0;
      margin: 15px 0 0;

      li {
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        background-color: transparent;
        border-radius: 5px;
        margin-bottom: 7px;
        padding: 5px 7px;
        transition: 0.5s;

        &:hover,
        &:active {
          background-color: rgba(39, 74, 183, 0.4);
        }

        &:last-child {
          margin-bottom: 0;
          margin-top: 20px;
          border-top: 1px solid rgba(255, 255, 255, 0.5);
          padding-top: 15px;
          border-radius: 0;
        }

        i {
          font-size: 16px;
          padding-right: 10px;
        }

      }

    }

  }

}

.adonitrans-plug {
  .adonitrans-tabs {
    width: auto;
    display: block;

    &-nav {
      border-radius: 20px 20px 0 0;
      background: #c6c6c6ad;

      li {
        background-color: transparent;
        color: #717171;
        padding: 15px 20px;
        font-size: 19px;

        &:first-child {
          border-radius: 20px 0 0 0;
        }

        &.active,
        &:hover {
          background-color: #086acf;
        }

      }

    }

  }

  #ajustes-generales {
    .franja,
    #wrap-tarifas-descuentos .row-tarifa {
      justify-content: start !important;
      background: #ffe3004f;
      padding: 15px 30px;
      border-radius: 15px;
      width: auto;

      .franja_item,
      .tarifa-item {
        margin-right: 30px;

        &:last-child {
          margin-right: 0;
        }

        label {
          font-size: 18px;
        }

      }

    }

    div {
      input,
      textarea {
        font-size: 16px;
      }

      button {
        &.button-remove {
          background: #e18d8d;
          color: #fff;
          font-size: 14px;
          padding: 0 15px;
          border-radius: 10px;
          margin-left: 0;
          transition: background 0.3s ease;
          transition: 0.3s;

          &:hover {
            background: #f95959;
            margin-left: 10px;
          }

          i {
            margin-right: 10px;
            transition: transform 0.3s ease;

            &:hover {
              font-size: 16px;
            }

          }

        }

        &.button-add {
          background: #0054ae;
          color: #fff;
          font-size: 16px;
          padding: 10px 15px;
          border-radius: 10px;
          margin-left: 0;
          transition: background 0.3s ease;
          transition: 0.3s;

          &:hover {
            background: #086ACF;
            margin-left: 10px;
          }

          i {
            margin-right: 10px;

            &:hover {
              font-size: 16px;
            }

          }

        }

        &.button-save {
          background: #FCD722;
          color: #000;
          font-size: 17px;
          text-transform: uppercase;
          padding: 10px 15px;
          border-radius: 15px;
          margin-top: 0;
          transition: 0.5s;

          &:hover {
            background: #086ACF;
            margin-top: -5px;
            color: #fff;
          }

        }

      }

    }

    #wrap-franjas-trabajo {
      .franja {
        width: auto;
      }

    }

  }

  .acordeon {
    .acordeon-item {
      .acordeon-header {
        border-radius: 10px 10px 0 0;
        background-color: #FBE474;
        color: #4d4c4c;
      }

      .acordeon-body {
        padding: 20px;
      }

    }

  }

}

.wrap-centro-costos {
  > .button {
    background-color: #0051a4;
    color: #fff;
    padding: 5px 15px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
  }

  .wrap-datos {
    .centro-costo {
      .button.remove-centro-row {
        background-color: #e18d8d;
        color: #fff;
        padding: 5px 15px;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
      }

    }

  }

}
