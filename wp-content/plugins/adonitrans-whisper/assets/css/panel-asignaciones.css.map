@use "global/variables" as *;

#wrap-asignaciones {
	.tarjeta {
		>.wrap {
			width: 100%;
		}

	}

	.volver {
		.button {
			cursor: pointer;

			i {
				font-size: 18px;
			}

		}

	}

	.botones {
		display: flex;
		flex-wrap: wrap;
		column-gap: 3em;
		width: 100%;
		justify-content: center;

		.boton {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			row-gap: 10px;
			text-align: center;
			width: 150px;
			height: 150px;
			padding: 0 15px;
			background-color: $primary-color;
			color: #fff;
			border-radius: 50%;
			border: 1px solid #939393;
			box-shadow: 0 0 4px 2px rgba(0, 0, 0, .25);
			cursor: pointer;
			transition: .5s;

			i {
				font-size: 30px;
				transform: rotate(-10deg);
				transition: .5s;
			}

			span {
				text-transform: uppercase;
				font-weight: 700;
				letter-spacing: .3px;
				font-family: 'Poppins';
			}

			&:hover {
				background-color: $color3;
				border: 1px solid #8d8d8d;
				box-shadow: 0 0 8px 2px rgba(0, 0, 0, .65);
				transform: scale(1.1);

				i {
					transform: rotate(0deg);
				}

			}

		}

	}

	.wrap-fanjas {
		.wrap-franja {
			margin-bottom: 30px;
			display: flex;
			flex-wrap: wrap;
			row-gap: 20px;
			width: 100%;
		}

		.franja {
			display: flex;
			flex-wrap: wrap;
			justify-content: start;
			column-gap: 30px;
			row-gap: 20px;
			width: 100%;
			background: rgba(255, 227, 0, .3098039216);
			padding: 15px 30px;
			border-radius: 15px;
			width: 100%;

			label:not(.error) {
				display: block;
				font-weight: 700;
				margin-bottom: 5px;
				font-size: 18px;
			}

			.remove {
				background-color: #f95959;

				&:hover {
					background-color: red;
					color: #fff;
				}

			}

			&:first-child {
				.button.remove {
					display: none;
				}

			}

		}

		.button-add {
			background: #0054ae;
			color: #fff;
			font-size: 16px;
			padding: 10px 15px;
			border-radius: 10px;
			margin-left: 0;
			transition: .3s;
			cursor: pointer;
		}

	}

}
